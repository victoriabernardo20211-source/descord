# ─── Ambiente ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Banco e cache ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379

# ─── Segredos ───────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-isto-por-no-minimo-32-caracteres-aleatorios
JWT_REFRESH_SECRET=troque-isto-tambem-por-32-caracteres-aleatorios
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Rede ───────────────────────────────────────────────────────────────────
PUBLIC_URL=http://localhost:4000
# O cliente é um app desktop, que não tem origem web fixa: em desenvolvimento
# carrega de localhost:5173 e empacotado carrega de file://. Restringir o CORS ao
# endereço do servidor simplesmente bloqueia o próprio app.
# `*` não afrouxa nada aqui: a autenticação é por token no cabeçalho, não por
# cookie, então não existe requisição autenticada "de brinde" para o CORS barrar.
CORS_ORIGINS=*

# ─── Arquivos ───────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=104857600

# ─── Conta e acesso ─────────────────────────────────────────────────────────
# O primeiro usuário criado com este e-mail vira administrador global.
INITIAL_ADMIN_EMAIL=
# Se preenchido, o cadastro exige este código (servidor privado).
REGISTRATION_INVITE_CODE=

# ─── Voz e tela (Fase 2/3) ──────────────────────────────────────────────────
# Endereço que o CLIENTE usa para falar com o SFU.
#   Tailscale:  ws://100.x.y.z:7880
#   Domínio:    wss://livekit.seudominio.com
LIVEKIT_URL=
# Gere com: openssl rand -hex 16  e  openssl rand -base64 36
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# IP que o LiveKit anuncia nos candidatos ICE. Com Tailscale, use o IP 100.x
# e deixe LIVEKIT_USE_EXTERNAL_IP=false — senão ele anuncia o IP público, que
# os clientes da rede privada não alcançam.
LIVEKIT_NODE_IP=
LIVEKIT_USE_EXTERNAL_IP=true
# Vazio em rede privada. Em servidor público, use aspas dentro do valor:
#   LIVEKIT_STUN_SERVERS='"stun.l.google.com:19302"'
LIVEKIT_STUN_SERVERS=
LIVEKIT_WEBHOOK_URL=http://127.0.0.1:4000/api/voice/webhook

# ─── Docker Compose (produção) ──────────────────────────────────────────────
POSTGRES_USER=nexus
POSTGRES_PASSWORD=
POSTGRES_DB=nexus
REDIS_PASSWORD=
NEXUS_DOMAIN=chat.seudominio.com
# Em qual endereço o Docker publica 80/443. Vazio = 0.0.0.0 (servidor público).
# Use o IP do Tailscale para que NADA fique exposto na internet — porta publicada
# pelo Docker NÃO passa pelo ufw, então é aqui que se fecha de verdade.
BIND_ADDRESS=
LIVEKIT_DOMAIN=livekit.seudominio.com
