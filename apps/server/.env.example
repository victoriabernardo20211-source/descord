# ─── Ambiente ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Banco e cache ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379

# ─── Segredos ───────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-isto-por-no-minimo-32-caracteres-aleatorios
JWT_REFRESH_SECRET=troque-isto-tambem-por-32-caracteres-aleatorios
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Rede ───────────────────────────────────────────────────────────────────
PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=*

# ─── Arquivos ───────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=104857600

# ─── Conta e acesso ─────────────────────────────────────────────────────────
# O primeiro usuário criado com este e-mail vira administrador global.
INITIAL_ADMIN_EMAIL=
# Se preenchido, o cadastro exige este código (servidor privado).
REGISTRATION_INVITE_CODE=

# ─── Voz e tela (Fase 2/3) ──────────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Docker Compose (produção) ──────────────────────────────────────────────
POSTGRES_USER=nexus
POSTGRES_PASSWORD=
POSTGRES_DB=nexus
REDIS_PASSWORD=
NEXUS_DOMAIN=chat.seudominio.com
LIVEKIT_DOMAIN=livekit.seudominio.com
